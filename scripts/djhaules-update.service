[Unit]
Description=DJ Haules — atualização automática no boot
After=network-online.target
Wants=network-online.target
Before=djhaules.service

[Service]
Type=oneshot
User=seu_usuario
WorkingDirectory=/home/seu_usuario/dj-haules
ExecStart=/home/seu_usuario/dj-haules/scripts/auto_update.sh
# Limite de 60s — se não concluir, o boot continua normalmente
TimeoutStartSec=60
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
